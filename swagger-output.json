  "definitions": {
    "Product": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "example": "Sony WH-1000XM5 Wireless Headphones"
        },
        "description": {
          "type": "string",
          "example": "Industry leading noise canceling headphones with two processors and 8 microphones."
        },
        "price": {
          "type": "number",
          "example": 398
        },
        "category": {
          "type": "string",
          "example": "Electronics"
        },
        "stockQuantity": {
          "type": "number",
          "example": 25
        },
        "brand": {
          "type": "string",
          "example": "Sony"
        },
        "sku": {
          "type": "string",
          "example": "SONY-WH1000XM5-BLK"
        },
        "rating": {
          "type": "number",
          "example": 4.8
        },
        "imageUrl": {
          "type": "string",
          "example": "https://m.media-amazon.com/images/I/61+elLndqVL._AC_SL1500_.jpg"
        }
      }
    },
    "Category": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "Electronics"
        },
        "description": {
          "type": "string",
          "example": "Smartphones, audio gear, computing accessories, and personal electronics."
        },
        "slug": {
          "type": "string",
          "example": "electronics"
        },
        "isActive": {
          "type": "boolean",
          "example": true
        }
      }
    },
    "Order": {
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "example": "gh-user-892147"
        },
        "customerEmail": {
          "type": "string",
          "example": "alex.shopper@example.com"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "productId": {
                "type": "string",
                "example": "6520a1b2c3d4e5f6a7b8c9d0"
              },
              "title": {
                "type": "string",
                "example": "Sony WH-1000XM5 Wireless Headphones"
              },
              "quantity": {
                "type": "number",
                "example": 1
              },
              "unitPrice": {
                "type": "number",
                "example": 398
              }
            }
          }
        },
        "totalAmount": {
          "type": "number",
          "example": 398
        },
        "shippingAddress": {
          "type": "object",
          "properties": {
            "street": {
              "type": "string",
              "example": "123 University Blvd"
            },
            "city": {
              "type": "string",
              "example": "Rexburg"
            },
            "state": {
              "type": "string",
              "example": "ID"
            },
            "zipCode": {
              "type": "string",
              "example": "83440"
            },
            "country": {
              "type": "string",
              "example": "USA"
            }
          }
        },
        "orderStatus": {
          "type": "string",
          "example": "Pending"
        }
      }
    },
    "Review": {
      "type": "object",
      "properties": {
        "productId": {
          "type": "string",
          "example": "6520a1b2c3d4e5f6a7b8c9d0"
        },
        "reviewerName": {
          "type": "string",
          "example": "Alex Johnson"
        },
        "rating": {
          "type": "number",
          "example": 5
        },
        "comment": {
          "type": "string",
          "example": "Superb noise cancellation and supreme all-day comfort. Highly recommended!"
        },
        "reviewDate": {
          "type": "string",
          "example": "2024-10-12"
        }
      }
    }
