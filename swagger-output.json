    "/": {
      "get": {
        "tags": [
          "Home"
        ],
        "description": "Welcome endpoint with API status, documentation link, and collection routes",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/auth/login": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "description": "Initiate GitHub OAuth 2.0 login authentication",
